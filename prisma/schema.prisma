generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id               String   @id @default(uuid())
  publicId         String   @unique
  serialNumber     String   @unique
  title            String
  summary          String?
  body             String
  issuedAt         DateTime
  effectiveFrom    DateTime
  expiresAt        DateTime?
  status           String   @default("ACTIVE")
  issuer           String
  department       String
  contentHash      String
  officialDocumentHash String?
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
  revocationReason String?
  
  links            MemoLink[]
  auditLogs        AuditLog[]
}

model MemoLink {
  id      String @id @default(uuid())
  label   String
  url     String
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model SerialCounter {
  yearMonth String @id
  lastValue Int    @default(0)
}

model LoginAttempt {
  id        String   @id @default(uuid())
  ipAddress String
  timestamp DateTime @default(now())
  success   Boolean
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  ipAddress String?
  userAgent String?
  metadata  String?  
  memoId    String?
  memo      Memo?    @relation(fields: [memoId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
}
