generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DATABASE_URL_UNPOOLED")
}

model Memo {
  id                   String     @id @default(uuid())
  publicId             String?    @unique
  visibility           String     @default("PUBLIC")
  officeCode           String     @default("PRES")
  officeName           String     @default("Office of the President")
  integrityVersion     Int        @default(1)
  issuingOffice        IssuingOffice @relation(fields: [officeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  serialNumber         String     @unique
  title                String
  summary              String?
  body                 String
  issuedAt             DateTime
  effectiveFrom        DateTime
  expiresAt            DateTime?
  status               String     @default("ACTIVE")
  issuer               String
  issuerPhone          String?
  addressedTo          String     @map("department")
  documentType         String     @default("Other")
  contentHash          String
  officialDocumentHash String?
  createdAt            DateTime   @default(now())
  revokedAt            DateTime?
  revocationReason     String?
  auditLogs            AuditLog[]
  links                MemoLink[]

  @@index([createdAt])
  @@index([status])
  @@index([visibility, status])
  @@index([officeCode])
}

model MemoLink {
  id     String @id @default(uuid())
  label  String
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model SerialCounter {
  counterKey String @id
  lastValue  Int    @default(0)
}

model IssuingOffice {
  code      String   @id
  name      String
  createdAt DateTime @default(now())
  memos     Memo[]

  @@map("IssuingOffice")
}

model AdminConfig {
  id               Int      @id @default(1)
  adminPathHash    String?
  adminPasswordHash String?
  authVersion      Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("AdminConfig")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  ipAddress String
  timestamp DateTime @default(now())
  success   Boolean

  @@index([ipAddress, timestamp])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  ipAddress String?
  userAgent String?
  metadata  String?
  memoId    String?
  timestamp DateTime @default(now())
  memo      Memo?    @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId, timestamp])
  @@index([timestamp])
}
