# Supabase PostgreSQL (server-side only; never use NEXT_PUBLIC_ for database credentials)
# The shared pooler host confirmed in Supabase Connect for project ayatnoolplaimcokvsfs.
# Runtime: least-privilege nacos_app role (do not use postgres for application traffic).
SUPABASE_DATABASE_URL="postgresql://nacos_app.ayatnoolplaimcokvsfs:[URL_ENCODED_APP_PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma migrations: database-owner role over the Session pooler (port 5432).
SUPABASE_DATABASE_URL_UNPOOLED="postgresql://postgres.ayatnoolplaimcokvsfs:[URL_ENCODED_DATABASE_PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Administrative Security
ADMIN_ROUTE_SECRET="generate-a-long-random-route-secret"
ADMIN_PASSWORD_HASH="$2a$10$YourBcryptHashGoesHere..."

# Cryptography & Integrity
AUTH_SECRET="generate-a-secure-random-string-here"
APP_SECRET="generate-another-secure-random-string-here"

# Public URLs
NEXT_PUBLIC_VERIFY_BASE_URL="http://localhost:3000"
